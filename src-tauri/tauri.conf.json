{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlphaTerm",
  "version": "0.4.0",
  "identifier": "uy.alphaterm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AlphaTerm",
        "width": 1100,
        "height": 700,
        "minWidth": 480,
        "minHeight": 300,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "conpty/conpty.dll": "conpty.dll",
      "conpty/OpenConsole.exe": "OpenConsole.exe"
    }
  }
}
